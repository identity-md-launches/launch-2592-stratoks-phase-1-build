# Copy to stratoks.env (same directory as docker-compose.yml) and edit. No secrets are required:
# the server never holds private keys; developers prove identity by wallet signature.

# Exact browser origins allowed to call the API / WebSocket and to sign in (comma separated, no trailing slash).
# Put the IMD-hosted static client origin here.
ALLOWED_ORIGINS=https://REPLACE-WITH-CLIENT-ORIGIN

# Lowercase 0x wallet addresses allowed to use the developer panel (interventions, backup, reset).
# Leave empty to disable developer access completely.
DEV_WALLETS=

# World parameters. INITIAL_SEED_COUNT/WORLD_SEED only matter the first time (new world). A restart never reseeds.
INITIAL_SEED_COUNT=24
WORLD_SEED=20260101
TICK_MS=1000

# Set to 1 only behind the Caddy proxy so rate limits see real client IPs.
TRUST_PROXY=1
LOG_LEVEL=info

# Optional: path (inside the container) of a JSON file merged over the defaults, for intervention limits etc.
# STRATOKS_CONFIG=/data/config.json
